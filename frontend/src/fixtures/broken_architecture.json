{
  "title": "URL Shortener (malformed variants)",
  "summary": "A deliberately malformed but schema-valid variant of the small URL shortener. It exists only to prove that layout and render survive soft-rule violations: a component in two groups, group nesting deeper than one level, a group with a missing parent, a self-loop, parallel connections, duplicate names and labels, one isolated component, one invalid pairing and one judgment pairing.",
  "requirements": [
    {
      "id": "req_create",
      "text": "Users can create a short link from a long URL.",
      "kind": "functional",
      "source": "prompt"
    },
    {
      "id": "req_latency",
      "text": "Redirects must complete in under 50 ms at p95.",
      "kind": "non_functional",
      "source": "prompt"
    },
    {
      "id": "req_single_region",
      "text": "The system must run in a single region.",
      "kind": "constraint",
      "source": "prompt"
    },
    {
      "id": "req_region_failover",
      "text": "The system must survive the loss of any single region.",
      "kind": "constraint",
      "source": "prompt"
    }
  ],
