{
  "name": "paladin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic layout and read-only render of an ArchitectureDraft.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "node scripts/generate-types.mjs",
    "generate:large": "node scripts/generate-large-fixture.mjs",
    "export:issues": "node scripts/export-issues.mjs",
    "check:deps": "node scripts/check-dependency-dates.mjs",
    "screenshots": "npm run export:issues && npm run build && playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "happy-dom": "21.0.4",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
