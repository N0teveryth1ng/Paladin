{
  "name": "paladin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Paladin architecture canvas — Next.js App Router UI",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "node scripts/generate-types.mjs",
    "generate:large": "node scripts/generate-large-fixture.mjs",
    "export:issues": "node scripts/export-issues.mjs",
    "check:deps": "node scripts/check-dependency-dates.mjs",
    "screenshots": "npm run export:issues && npm run build && playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elkjs": "0.12.1",
    "lucide-react": "1.82.0",
    "next": "16.4.6",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "happy-dom": "21.0.4",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.34",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
