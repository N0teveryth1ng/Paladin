{
  "title": "URL Shortener",
  "summary": "A single-region URL shortener. Writes go through an API gateway to a shortener service backed by PostgreSQL; redirects are served from a Redis cache in front of the database. The prompt contains a genuine conflict between the single-region constraint and the region-failover constraint, so the design is delivered with a blocking flag.",
  "requirements": [
    {
      "id": "req_create",
      "text": "Users can create a short link from a long URL.",
      "kind": "functional",
      "source": "prompt"
    },
    {
      "id": "req_latency",
      "text": "Redirects must complete in under 50 ms at p95.",
      "kind": "non_functional",
      "source": "prompt"
    },
    {
      "id": "req_single_region",
      "text": "The system must run in a single region.",
      "kind": "constraint",
      "source": "prompt"
    },
    {
      "id": "req_region_failover",
      "text": "The system must survive the loss of any single region.",
      "kind": "constraint",
      "source": "prompt"
    }
  ],
  "components": [
    {
      "id": "cmp_web",
      "type": "client",
      "name": "Web Client",
      "technology": "React",
      "description": "Browser application where users create short links and follow redirects.",
      "attributes": {},
      "requirement_refs": [
        "req_create"
      ],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_gateway",
      "type": "api_gateway",
      "name": "API Gateway",
      "technology": "Kong",
      "description": "Single entry point for create and redirect traffic.",
      "attributes": {},
      "requirement_refs": [
        "req_create",
        "req_latency"
      ],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_shortener",
      "type": "service",
      "name": "Shortener Service",
      "technology": "FastAPI",
      "description": "Creates short codes and resolves them to target URLs.",
      "attributes": {
        "replicas": "2"
      },
      "requirement_refs": [
        "req_create",
        "req_latency"
      ],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_db",
      "type": "database",
      "name": "Link Database",
      "technology": "PostgreSQL",
      "description": "Durable store of short code to target URL mappings.",
      "attributes": {
        "consistency": "strong",
        "replicas": "3"
      },
      "requirement_refs": [
        "req_create"
      ],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_cache",
      "type": "cache",
      "name": "Redirect Cache",
      "technology": "Redis",
      "description": "Hot redirect mappings, keeping p95 redirect latency under budget.",
