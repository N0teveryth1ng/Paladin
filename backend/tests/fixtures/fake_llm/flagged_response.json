        "consistency": "not_applicable",
        "protocol": "tcp"
      },
      "requirement_refs": [
        "req_latency"
      ],
      "assumed": false,
      "rationale": null
    }
  ],
  "connections": [
    {
      "id": "cnx_client_gateway",
      "from": "cmp_web",
      "to": "cmp_gateway",
      "type": "sync",
      "label": "HTTPS requests",
      "technology": "https",
      "requirement_refs": [
        "req_create"
      ],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cnx_gateway_service",
      "from": "cmp_gateway",
      "to": "cmp_shortener",
