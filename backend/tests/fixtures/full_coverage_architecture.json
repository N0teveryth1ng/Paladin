  "assumptions": [
    {
      "id": "asm_resolution",
      "text": "Transcoding targets 720p and 1080p renditions only; there is no 4K output in v1.",
      "scope": "element",
      "element_refs": ["cmp_transcoder"],
      "rationale": "The prompt does not state target resolutions."
    },
    {
      "id": "asm_traffic",
      "text": "50,000 concurrent viewers is a peak figure; average load is a fifth of peak.",
      "scope": "global",
      "element_refs": [],
      "rationale": "The prompt gives a peak number without an average, and cost sizing depends on it."
    },
    {
      "id": "asm_retention",
      "text": "Uploaded videos are retained indefinitely; there is no deletion workflow in v1.",
      "scope": "element",
      "element_refs": ["cmp_storage"],
      "rationale": "The prompt does not state a retention policy."
    }
  ],
  "flags": [
    {
      "id": "flg_retention",
      "kind": "underspecified",
      "description": "No retention or deletion policy is stated for uploaded videos, so storage growth and cost cannot be bounded.",
