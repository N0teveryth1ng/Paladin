{
  "title": "Video Streaming Platform",
  "summary": "A video platform covering upload, asynchronous transcoding, adaptive playback, search, auth and billing. Edge CDN serves static assets and video segments; the API service owns metadata, search queries and payment calls; a Kafka queue decouples transcoding from upload. Data-tier services sit inside the core platform boundary. Peak concurrency drives the cache and load balancer sizing.",
  "requirements": [
    {
      "id": "req_auth",
      "text": "Users must sign in with email and password.",
      "kind": "functional",
      "source": "prompt"
    },
    {
      "id": "req_upload",
      "text": "Creators upload videos, which are transcoded asynchronously into multiple renditions.",
      "kind": "functional",
      "source": "prompt"
    },
    {
      "id": "req_playback",
      "text": "Viewers stream videos with adaptive bitrate playback.",
      "kind": "functional",
      "source": "prompt"
    },
    {
      "id": "req_search",
      "text": "Viewers can search videos by title and description.",
      "kind": "functional",
      "source": "prompt"
    },
    {
      "id": "req_reports",
      "text": "Operators receive a nightly usage report.",
      "kind": "functional",
      "source": "prompt"
    },
    {
      "id": "req_scale",
      "text": "The system must serve 50,000 concurrent viewers with p95 playback start under 2 seconds.",
      "kind": "non_functional",
      "source": "prompt"
    },
    {
      "id": "req_budget",
      "text": "Monthly infrastructure spend must stay under 2,000 USD.",
      "kind": "constraint",
      "source": "prompt"
    }
  ],
  "components": [
    {
      "id": "cmp_web_client",
      "type": "client",
      "name": "Web Client",
      "technology": "React",
      "description": "Browser application for uploading, browsing, searching and watching videos.",
      "attributes": {},
      "requirement_refs": ["req_playback", "req_search"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_mobile_client",
      "type": "client",
      "name": "Mobile Client",
      "technology": "React Native",
      "description": "Mobile application for browsing and watching videos.",
      "attributes": {},
      "requirement_refs": ["req_playback"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_edge_cdn",
      "type": "cdn",
      "name": "Edge CDN",
      "technology": "Cloudflare",
      "description": "Caches static assets and video segments close to viewers.",
      "attributes": {
        "protocol": "https"
      },
      "requirement_refs": ["req_playback", "req_scale"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_gateway",
      "type": "api_gateway",
      "name": "API Gateway",
      "technology": "Kong",
      "description": "Single entry point for authenticated API traffic.",
      "attributes": {},
      "requirement_refs": ["req_playback", "req_auth"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_load_balancer",
      "type": "load_balancer",
      "name": "Load Balancer",
      "technology": "HAProxy",
      "description": "Spreads API traffic across service replicas.",
      "attributes": {
        "replicas": "2"
      },
      "requirement_refs": ["req_scale"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_auth",
      "type": "auth_provider",
      "name": "Identity Provider",
      "technology": "Keycloak",
      "description": "Issues and validates user sessions and tokens.",
      "attributes": {
        "consistency": "strong"
      },
      "requirement_refs": ["req_auth"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_api",
      "type": "service",
      "name": "API Service",
      "technology": "FastAPI",
      "description": "Owns metadata, upload orchestration, search queries and billing calls.",
      "attributes": {
        "replicas": "4"
      },
      "requirement_refs": ["req_playback", "req_search", "req_upload"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_transcoder",
      "type": "worker",
      "name": "Transcode Worker",
      "technology": "FFmpeg",
      "description": "Consumes transcode jobs and writes renditions back to object storage.",
      "attributes": {
        "replicas": "8"
      },
      "requirement_refs": ["req_upload"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_db",
      "type": "database",
      "name": "Primary Database",
      "technology": "PostgreSQL",
      "description": "Durable store of users, video metadata and transcode job state.",
      "attributes": {
        "consistency": "strong",
        "replicas": "3"
      },
      "requirement_refs": ["req_auth", "req_upload"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_cache",
      "type": "cache",
      "name": "Session Cache",
      "technology": "Redis",
      "description": "Hot session and metadata lookups that keep p95 playback start within budget.",
      "attributes": {
        "consistency": "not_applicable",
        "protocol": "tcp"
      },
      "requirement_refs": ["req_scale"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_queue",
      "type": "message_queue",
      "name": "Transcode Queue",
      "technology": "Kafka",
      "description": "Durable job queue decoupling upload from transcoding.",
      "attributes": {
        "protocol": "other"
      },
      "requirement_refs": ["req_upload"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_storage",
      "type": "object_storage",
      "name": "Video Store",
      "technology": "S3",
      "description": "Stores original uploads and every transcoded rendition.",
      "attributes": {
        "protocol": "https"
      },
      "requirement_refs": ["req_upload", "req_playback"],
      "assumed": false,
      "rationale": null
    },
    {
      "id": "cmp_search",
      "type": "search_index",
      "name": "Video Search Index",
      "technology": "OpenSearch",
      "description": "Full-text index over video titles and descriptions.",
      "attributes": {
        "consistency": "eventual"
      },
      "requirement_refs": ["req_search"],
      "assumed": false,
      "rationale": null
